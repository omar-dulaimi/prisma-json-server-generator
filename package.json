{
  "name": "prisma-json-server-generator",
  "version": "0.3.0",
  "description": "Prisma 2+ generator to emit a JSON file that can be run with json-server",
  "repository": "https://github.com/omar-dulaimi/prisma-json-server-generator",
  "bin": {
    "prisma-json-server-generator": "lib/generator.js"
  },
  "scripts": {
    "gen-example": "tsc && cp -r src/lowdb lib && npx prisma generate",
    "package:publish": "./package.sh && cd package && npm publish",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "package": "./package.sh",
    "release": "semantic-release"
  },
  "author": {
    "name": "Omar Dulaimi",
    "url": "https://github.com/omar-dulaimi"
  },
  "keywords": [
    "prisma",
    "prisma-client",
    "prisma-schema",
    "prisma-generator",
    "json-server",
    "prisma-json-server-generator"
  ],
  "license": "MIT",
  "dependencies": {
    "@faker-js/faker": "^9.9.0",
    "@prisma/generator-helper": "^6.14.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^24.3.0",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "prisma": "^6.14.0",
    "semantic-release": "^25.0.8",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "bugs": {
    "url": "https://github.com/omar-dulaimi/prisma-json-server-generator/issues"
  },
  "homepage": "https://github.com/omar-dulaimi/prisma-json-server-generator#readme",
  "private": true
}
